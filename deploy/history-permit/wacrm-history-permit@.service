[Unit]
Description=Consume one WACRM history permit

[Service]
User=wacrm-history-store
Group=wacrm-history-store
ExecStart=/usr/bin/python3 -I -B /opt/wacrm-history-permit/consume.py
StandardInput=socket
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/wacrm-history-permit
UMask=0077
RuntimeMaxSec=3s
