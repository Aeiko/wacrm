# Generate deploy/supabase/.env and root .env.local with npm run supabase:init.
# Never run with these placeholders. Production setup: docs/self-hosting.md.
POSTGRES_PASSWORD=GENERATE
JWT_SECRET=GENERATE
ANON_KEY=GENERATE
SERVICE_ROLE_KEY=GENERATE
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=GENERATE
SECRET_KEY_BASE=GENERATE
REALTIME_DB_ENC_KEY=GENERATE
VAULT_ENC_KEY=GENERATE
PG_META_CRYPTO_KEY=GENERATE
S3_PROTOCOL_ACCESS_KEY_ID=GENERATE
S3_PROTOCOL_ACCESS_KEY_SECRET=GENERATE

SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**
API_GW_HTTP_PORT=8000
DB_HOST_PORT=54322
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=noreply@localhost.test
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=WACRM
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Legacy HS256 keys match the app's existing auth integration.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
STUDIO_DEFAULT_ORGANIZATION=WACRM
STUDIO_DEFAULT_PROJECT=WACRM
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=local
IMGPROXY_AUTO_WEBP=true

# Optional extras profile; not needed by WACRM.
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=512m
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=wacrm
POOLER_DB_POOL_SIZE=5
